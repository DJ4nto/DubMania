# URL publique de votre projet Supabase.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clé publishable publique Supabase.
# Elle est intégrée au bundle frontend : ce n'est pas un secret.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# "/" pour un domaine personnalisé ou username.github.io.
# "/dubmania/" pour username.github.io/dubmania/.
VITE_BASE_PATH=/dubmania/

# Facultatif. Active davantage de logs locaux.
VITE_DEBUG=false
